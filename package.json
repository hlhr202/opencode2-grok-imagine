{
  "name": "opencode2-grok-imagine",
  "version": "1.0.1",
  "description": "OpenCode 2 plugin for xAI Grok Imagine image generation, text-to-video and image-to-video via CLIProxyAPI/OpenAI-compatible endpoints.",
  "type": "module",
  "license": "MIT",
  "author": "hlhr202",
  "keywords": [
    "opencode",
    "opencode-v2",
    "opencode-plugin",
    "grok",
    "grok-imagine",
    "grok-image",
    "grok-video",
    "xai",
    "image-generation",
    "video-generation",
    "text-to-image",
    "text-to-video",
    "image-to-video",
    "cli-proxy-api",
    "cliproxyapi",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlhr202/opencode2-grok-imagine.git"
  },
  "homepage": "https://github.com/hlhr202/opencode2-grok-imagine#readme",
  "bugs": {
    "url": "https://github.com/hlhr202/opencode2-grok-imagine/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  }
}
